	"scripts": {
		"build:analyze": "vite build --mode analyze",
		"preinstall": "npx only-allow pnpm",
		"watch": "vite build --watch",
		"serve": "vite --force",
		"build": "vite build",
		"fmt": "biome format --write",
		"check": "biome check --write --max-diagnostics 10000",
		"ci": "biome ci",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"unused": "npm dlx knip",
		"gen": "npx @bufbuild/buf generate"
	},
