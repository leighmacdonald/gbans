{{define "ac_logs"}}
# Anticheat Detections (count: {{ .Count }}

Player: **[{{ .Player.GetName }}]({{ .Player | linkPath }})** Steam ID: **{{ .Player.GetSteamIDString }}**
{{ range $key, $value := .Detections }}
    {{$key}}: {{ $value }}
{{ end }}

{{ range $key, $value := .Servers }}
    {{$key}}: {{ $value }}
{{ end }}
{{end}}

{{define "ac_trigger"}}
# Player triggered anti-cheat response

Player: **[{{ .PlayerName }}]({{ .PlayerProfile }})** Steam ID: **{{ .Entry.SteamID | sidString }}**
Server: **{{ .Entry.ServerName }}**
Detection: {{ .Detection }}
Count: {{ .Count }}
Action {{ .Action }}
{{- if ne .Entry.DemoName "" }}
    Demo Name: {{ .Entry.DemoName }}
    Demo Tick: {{ .Entry.DemoTick }}
{{ end }}
{{ .Note  }}
{{end}}
