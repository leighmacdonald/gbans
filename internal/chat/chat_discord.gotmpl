{{define "filter_check"}}
    # Matches {{ if .Matches }}Found{{else}}Not Found{{end}}
    {{range .Matches }}
        ID: {{ .FilterID }} Pattern: {{ .Pattern }}
    {{end}}
{{end}}

{{define "filter_warning"}}
    # Language Warning
    Player: **[{{ .Player }}]({{ .Profile }})** Steam ID: **{{ .SteamID }}**
    FilterID: {{ .FilterID }}
    Matched: {{ .Matched }}
    Server: {{ .Server }}
    Pattern: {{ .Pattern }}
    Expires In: {{ .ExpiresIn }}
    Expires At: {{ .ExpiresAt }}
{{end}}

{{define "filter_warning_flagged"}}
    # Chat Filter Warning
    Player: **[{{ .Player }}]({{ .Profile }})** Steam ID: **{{ .SteamID }}**
    Server: {{ .Server }}
    Pattern: {{ .Pattern }}
    Matched: {{ .Matched }}
    Current Warnings: **{{ .WarningCount }}** · Weight: **{{ .CurrentWeight }}/{{ .MaxWeight }}**
    Window Resets In: {{ .WindowResetsIn }}
{{end}}

{{define "chat_message"}}
`{{ .Msg.ServerName }}` [{{ .Msg.PersonaName }}]( {{ .Player | linkPath }}){{ if .Msg.Team}} (Team){{end}}: {{ .Msg.Body }}
{{end}}